# ==============================================================================
# CareSync Hospital Management System (HMS) - Client Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND API CONNECTION
# ------------------------------------------------------------------------------

# OPTION A: Direct Cloud Backend (Recommended for Production & Cloud Hosting)
# Set this to your deployed cloud backend URL.
# Supports either root origin or full /api path:
# Examples:
#   VITE_API_BASE_URL="https://caresync-backend.onrender.com"
#   VITE_API_BASE_URL="https://caresync-api.railway.app/api"
#   VITE_API_BASE_URL="https://api.yourdomain.com"
VITE_API_BASE_URL=

# OPTION B: Local Development / Dev Server Proxy
# If VITE_API_BASE_URL is left blank, Vite defaults to relative '/api'.
# During 'npm run dev', Vite will proxy '/api' and '/uploads' to this target:
VITE_API_PROXY_TARGET="http://localhost:5000"
