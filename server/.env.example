# ==============================================================================
# CareSync Hospital Management System (HMS) - Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Choose either a CLOUD database or a LOCAL database and set DATABASE_URL accordingly.

# OPTION A: Cloud PostgreSQL (Recommended for Production & Cloud Hosting)
# ------------------------------------------------------------------------------
# Supabase:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
#
# Neon Tech:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"
#
# Render PostgreSQL:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST].render.com/[DB_NAME]?sslmode=require"
#
# Railway PostgreSQL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway"
#
# AWS RDS / Aurora:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[RDS-ENDPOINT]:5432/hms_db?sslmode=require"

# OPTION B: Local PostgreSQL (Docker or Native PostgreSQL on localhost)
# ------------------------------------------------------------------------------
# To start with Docker: run `docker compose up -d` in project root
DATABASE_URL="postgresql://postgres:password@localhost:5432/hms_db"

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
JWT_SECRET="super-secret-hms-jwt-key-2026"
JWT_EXPIRES_IN="1d"
NODE_ENV="development"
# Comma-separated list of allowed frontend origins, or '*'
CORS_ORIGIN="http://localhost:5173,https://hms-project-orpin.vercel.app"
